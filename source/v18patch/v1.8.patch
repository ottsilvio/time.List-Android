+    private View paletteDetailsView(String style) {
+        int[] colors = PaletteManager.colorsFor(style);
+        String[] names = PaletteManager.colorNamesFor(style);
+        String[] details = PaletteManager.colorDetailsFor(style);
+        LinearLayout list = new LinearLayout(this);
+        list.setOrientation(LinearLayout.VERTICAL);
+        list.setPadding(0, dp(2), 0, dp(4));
+
+        int count = Math.min(colors.length, Math.min(names.length, details.length));
+        for (int i = 0; i < count; i++) {
+            LinearLayout row = new LinearLayout(this);
+            row.setOrientation(LinearLayout.HORIZONTAL);
+            row.setGravity(Gravity.CENTER_VERTICAL);
+            row.setPadding(dp(10), dp(8), dp(10), dp(8));
+            row.setBackground(outlinedRoundRect(Color.rgb(250, 249, 251), Color.rgb(233, 230, 236), 11, 0.55f));
+
+            View swatch = new View(this);
+            swatch.setBackground(roundRect(colors[i], 8));
+            LinearLayout.LayoutParams swatchLp = new LinearLayout.LayoutParams(dp(34), dp(34));
+            swatchLp.rightMargin = dp(11);
+            row.addView(swatch, swatchLp);
+
+            LinearLayout words = new LinearLayout(this);
+            words.setOrientation(LinearLayout.VERTICAL);
+            words.addView(text(names[i], 14.2f, Color.rgb(49, 47, 56), true));
+            TextView detail = text(details[i], 12.5f, Color.rgb(115, 111, 122), false);
+            detail.setPadding(0, dp(2), 0, 0);
+            detail.setLineSpacing(0, 1.08f);
+            words.addView(detail);
+            row.addView(words, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+
+            LinearLayout.LayoutParams rowLp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+            rowLp.bottomMargin = dp(6);
+            list.addView(row, rowLp);
+        }
+        return list;
+    }
