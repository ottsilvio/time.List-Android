eedData.BLUE, SeedData.TEAL, SeedData.PINK,
+            SeedData.GREEN, SeedData.ORANGE, SeedData.CYAN, SeedData.ROSE, SeedData.GOLD
+    };
+
+    private PaletteManager() {}
+
+    public static String current(Context c) {
+        SharedPreferences p = c.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        return p.getString(KEY, MORANDI);
+    }
+
+    public static String label(String key) {
+        return CHINESE.equals(key) ? "中国传统色" : "经典莫兰迪";
+    }
+
+    public static int[] colors(Context c) {
+        return CHINESE.equals(current(c)) ? CHINESE_COLORS.clone() : MORANDI_COLORS.clone();
+    }
+
+    public static String[] colorNames(Context c) {
+        return CHINESE.equals(current(c)) ? CHINESE_NAMES.clone() : MORANDI_NAMES.clone();
+    }
+
+    public static int renderColor(Context c, CourseBlock course) {
+        int[] palette = colors(c);
+        if (course != null && course.notes != null && course.notes.startsWith("@TL_NOTE|")) {
+            return palette[8];
+        }
+        int idx = course == null ? 0 : indexForColor(course.color);
+        if (idx < 0 && course != null && course.title != null) idx = Math.floorMod(course.title.hashCode(), palette.length);
+        if (idx < 0) idx = 0;
+        return palette[idx % palette.length];
+    }
+
+    public static int indexForColor(int color) {
+        for (int i = 0; i < LEGACY.length; i++) if (LEGACY[i] == color) return i;
+        for (int i = 0; i < MORANDI_COLORS.length; i++) if (MORANDI_COLORS[i] == color) return i;
+        for (int i = 0; i < CHINESE_COLORS.length; i++) if (CHINESE_COLORS[i] == color) return i;
+        return -1;
+    }
+
+    public static int indexForEditorColor(Context c, int color) {
+        int idx = indexForColor(color);
+        if (idx >= 0) return idx;
+        int[] palette = colors(c);
+        int best = 0;
+        long bestDist = Long.MAX_VALUE;
+        for (int i = 0; i < palette.length; i++) {
+            long dr = Color.red(color) - Color.red(palette[i]);
+            long dg = Color.green(color) - Color.green(palette[i]);
+            long db = Color.blue(color) - Color.blue(palette[i]);
+            long dist = dr * dr + dg * dg + db * db;
+            if (dist < bestDist) { bestDist = dist; best = i; }
+        }
+        return best;
+    }
+}
